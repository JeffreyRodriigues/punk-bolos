# ============================================================
# PUNK BOLOS — Variáveis de ambiente (exemplo)
# ------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com os dados do seu
# projeto Supabase (Dashboard → Configurações do Projeto → API).
# O arquivo .env NÃO deve ser commitado no git.
#
# No Render (produção): painel → serviço → Environment →
# New variable com os MESMOS nomes abaixo.
# ============================================================

# URL do projeto Supabase (pública)
SUPABASE_URL=https://seu-projeto.supabase.co

# Anon public key do Supabase (pública por design, mas fora do git)
SUPABASE_ANON_KEY=sua_anon_key_aqui
